#pragma code_page(65001)
#include <winres.h>
#include "src/installDialog.h"
IDI_COCOGOAT ICON DISCARDABLE "cocogoat.ico"
IDI_INSTALL_LOGO ICON "installer-logo.ico"
302 RCDATA "installer-logo.LICENSE"

IDD_INSTALL DIALOGEX 0, 0, 300, 144
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "椰羊·霜华安装程序"
FONT 9, "Microsoft YaHei UI"
BEGIN
    CONTROL "椰羊·霜华", IDC_INSTALL_HEADER, "Static", SS_OWNERDRAW, 0, 0, 300, 48
    LTEXT "安装位置(&L)", IDC_INSTALL_LABEL, 16, 62, 268, 12
    EDITTEXT IDC_INSTALL_PATH, 16, 77, 214, 16, ES_AUTOHSCROLL
    PUSHBUTTON "浏览(&B)…", IDC_INSTALL_BROWSE, 236, 76, 48, 18
    LTEXT "", IDC_INSTALL_DESTINATION, 16, 98, 268, 12, SS_NOPREFIX | SS_PATHELLIPSIS
    CONTROL "", IDC_INSTALL_PROGRESS, "msctls_progress32", WS_CHILD | NOT WS_VISIBLE, 16, 79, 268, 11
    EDITTEXT IDC_INSTALL_RESULT, 16, 79, 268, 34, ES_READONLY | ES_MULTILINE | ES_AUTOVSCROLL | NOT WS_VISIBLE | NOT WS_BORDER
    PUSHBUTTON "取消", IDCANCEL, 178, 118, 48, 18
    DEFPUSHBUTTON "安装(&I)", IDOK, 232, 118, 52, 18, BS_OWNERDRAW
END
1 VERSIONINFO
FILEVERSION 1,3,1,0
PRODUCTVERSION 1,3,1,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
        VALUE "CompanyName",      "YuehaiTeam"
        VALUE "FileDescription",  "cocogoat Frostflake Plugin"
        VALUE "FileVersion",      "1.3.1.0"
    END
    BLOCK "080404E4"
    BEGIN
        VALUE "CompanyName",      "月海亭 YuehaiTeam"
        VALUE "FileDescription",  "椰羊·霜华插件"
        VALUE "FileVersion",      "1.3.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1252
    VALUE "Translation", 0x0409, 1252
  END
END
209 MENU
BEGIN
    POPUP ""
	BEGIN
	MENUITEM "退出 (E&xit)", 124
	END
END
